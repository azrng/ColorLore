---
import { groupByFamily, colorFamily, FAMILY_NAMES } from '../lib/color';

interface ColorItem {
  id: string;
  data: { name: string; slug?: string; hex: string; order: number };
}

interface Props {
  colors: ColorItem[];
  currentId?: string;
}

const { colors, currentId } = Astro.props;
const groups = groupByFamily(colors);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const searchable = (c: ColorItem) =>
  `${c.data.name} ${c.data.slug ?? c.id} ${c.data.hex} ${FAMILY_NAMES[colorFamily(c.data.hex)]}`.toLowerCase();
---

<aside class="sidebar">
  <a class="brand" href={`${base}/`}>
    <span class="brand-mark" aria-hidden="true">色</span>
    <span>
      <span class="brand-latin">ColorLore</span>
      <span class="brand-cn">中国传统色</span>
    </span>
  </a>
  <input
    class="color-search"
    type="search"
    placeholder="搜索颜色"
    aria-label="搜索颜色"
    data-target="#color-nav"
    data-empty="#sidebar-empty"
  />
  <p class="list-empty" id="sidebar-empty" hidden>没有匹配的颜色</p>
  <nav class="color-nav" id="color-nav" aria-label="颜色列表">
    {
      groups.map((g) => (
        <div class="color-group">
          <p class="group-name">{g.name}</p>
          {g.colors.map((c) => (
            <a
              class:list={['color-item', { active: c.id === currentId }]}
              style={`--c:${c.data.hex}`}
              href={`${base}/color/${c.id}/`}
              data-search={searchable(c)}
            >
              <span class="sw" aria-hidden="true" />
              <span>
                <span class="cn">{c.data.name}</span>
                <span class="py">{(c.data.slug ?? c.id).toUpperCase()}</span>
              </span>
              <span class="hexcode">{c.data.hex}</span>
            </a>
          ))}
        </div>
      ))
    }
  </nav>
  <a class="repo" href="https://github.com/azrng/ColorLore" target="_blank" rel="noopener">
    GitHub 仓库
  </a>
</aside>

<script>
  // 进入页面时把当前颜色滚动到可视区
  document.addEventListener('astro:page-load', () => {
    document
      .querySelector('.color-nav .color-item.active')
      ?.scrollIntoView({ block: 'nearest' });
  });

  // 搜索过滤：事件委托在 document 上，页面切换后依然有效
  function handleSearch(input: HTMLInputElement) {
    const q = input.value.trim().toLowerCase();
    const scope = document.querySelector(input.dataset.target ?? '');
    if (!scope) return;
    let matched = 0;
    scope.querySelectorAll('.color-group').forEach((group) => {
      let visible = 0;
      group.querySelectorAll('[data-search]').forEach((item) => {
        const hit = !q || (item.getAttribute('data-search') ?? '').includes(q);
        item.toggleAttribute('hidden', !hit);
        if (hit) visible++;
      });
      group.toggleAttribute('hidden', visible === 0);
      matched += visible;
    });
    const empty = input.dataset.empty
      ? document.querySelector(input.dataset.empty)
      : null;
    if (empty) empty.toggleAttribute('hidden', !(q && matched === 0));
  }

  document.addEventListener('input', (e) => {
    const input = (e.target as Element).closest('.color-search');
    if (input instanceof HTMLInputElement) handleSearch(input);
  });
</script>
