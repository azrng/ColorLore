---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { textColorOn } from '../lib/color';

const colors = (await getCollection('colors')).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="中国传统色 · ColorLore"
  description="一色一诗，一色一源，一色一物。点开一个颜色，让整个页面染上它的底色。"
>
  <main class="cover">
    <header class="cover-head">
      <h1>中国传统色</h1>
      <p class="cover-sub">
        一色一诗，一色一源，一色一物。点开一个颜色，让整个页面染上它的底色。
      </p>
    </header>
    <ul class="bands">
      {
        colors.map((c) => (
          <li>
            <a
              class="band"
              style={`--c:${c.data.hex}; --c-text:${textColorOn(c.data.hex)}`}
              href={`${base}/color/${c.id}/`}
            >
              <span class="band-name">{c.data.name}</span>
              <span class="band-meta">
                <span>{(c.data.slug ?? c.id).toUpperCase()}</span>
                <span>{c.data.hex}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
