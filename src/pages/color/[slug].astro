---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { textColorOn } from '../../lib/color';

export async function getStaticPaths() {
  const colors = (await getCollection('colors')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return colors.map((color) => ({
    params: { slug: color.id },
    props: { color, colors },
  }));
}

const { color, colors } = Astro.props;
const { Content } = await render(color);
const pinyin = (color.data.slug ?? color.id).toUpperCase();
const idx = colors.findIndex((c) => c.id === color.id);
const prev = idx > 0 ? colors[idx - 1] : undefined;
const next = idx < colors.length - 1 ? colors[idx + 1] : undefined;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title={`${color.data.name} · 中国传统色`}
  description={`中国传统色「${color.data.name}」：一色一诗，一色一源，一色一物。`}
  hex={color.data.hex}
>
  <div class="shell">
    <Sidebar colors={colors} currentId={color.id} />
    <main class="article">
      <header class="color-head">
        <p class="kicker">{pinyin}</p>
        <h1>{color.data.name}</h1>
        <div
          class="swatch-band"
          style={`background:${color.data.hex}; color:${textColorOn(color.data.hex)}`}
        >
          <span class="swatch-hex">{color.data.hex}</span>
        </div>
      </header>
      <article class="prose">
        <Content />
      </article>
      <nav class="pager" aria-label="相邻颜色">
        {
          prev && (
            <a class="pager-link" style={`--c:${prev.data.hex}`} href={`${base}/color/${prev.id}/`}>
              <span class="sw" aria-hidden="true" />
              <span>
                <span class="pager-dir">上一色</span>
                <span class="pager-name">{prev.data.name}</span>
              </span>
            </a>
          )
        }
        {
          next && (
            <a
              class="pager-link pager-next"
              style={`--c:${next.data.hex}`}
              href={`${base}/color/${next.id}/`}
            >
              <span class="sw" aria-hidden="true" />
              <span>
                <span class="pager-dir">下一色</span>
                <span class="pager-name">{next.data.name}</span>
              </span>
            </a>
          )
        }
      </nav>
    </main>
  </div>
</Base>
